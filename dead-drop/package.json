    "express": "^5.2.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
