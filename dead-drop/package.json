{
  "name": "dead-drop",
  "version": "1.0.0",
  "description": "Dead Drop - a faithful Fortnite Chapter 1 style battle royale built on Three.js",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
